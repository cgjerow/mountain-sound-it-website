---
import DefaultLayout from '../../layouts/default.astro'
import Content from '../../layouts/body-content.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blogs')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const [featured, ...older] = posts

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
---
<DefaultLayout>
  <Content>
    <h1>Blog</h1>

    {featured ? (
      <article class="featured">
        <p class="meta">Latest · {formatDate(featured.data.pubDate)}</p>
        <h2 class="featured-title">
          <a href={`/blogs/${featured.id}`}>{featured.data.title}</a>
        </h2>
        <p class="featured-description">{featured.data.description}</p>
        <p class="read-more">
          <a href={`/blogs/${featured.id}`}>Read the full post</a>
        </p>
      </article>
    ) : (
      <p>No posts yet. Check back soon.</p>
    )}

    {older.length > 0 && (
      <section class="older" aria-label="Earlier posts">
        <h2 class="older-heading">Earlier posts</h2>
        <ul class="post-list">
          {older.map((post) => (
            <li>
              <p class="meta">{formatDate(post.data.pubDate)}</p>
              <h3 class="post-title">
                <a href={`/blogs/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="post-description">{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </Content>
</DefaultLayout>

<style>
  a {
    color: #0a9ef0;
  }

  h1,
  h2,
  h3 {
    font-family: Roboto, sans-serif;
  }

  p, li {
    font-size: 1.2rem;
    font-weight: 300;
    font-family: Roboto, sans-serif;
  }

  .meta {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    color: #555;
  }

  .featured {
    margin-top: 1.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid #ddd;
  }

  .featured-title {
    margin: 0 0 0.75rem;
    font-size: 2rem;
    line-height: 1.2;
  }

  .featured-title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-title a:hover {
    color: #0a9ef0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .featured-description {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .read-more {
    margin: 0;
  }

  .read-more a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .older {
    margin-top: 1.75rem;
    padding-bottom: 2rem;
  }

  .older-heading {
    margin: 0 0 1rem;
    font-size: 1.35rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    margin: 0 0 1.25rem;
    padding: 0 0 1.25rem;
    border-bottom: 1px solid #eee;
  }

  .post-list li:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .post-title {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .post-title a {
    color: inherit;
    text-decoration: none;
  }

  .post-title a:hover {
    color: #0a9ef0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  @media screen and (max-width: 767px) {
    .featured-title {
      font-size: 1.45rem;
    }

    .featured-description {
      font-size: 1.05rem;
    }

    p, li {
      font-size: 1rem;
    }

    .meta {
      font-size: 0.85rem;
    }

    .post-title {
      font-size: 1.1rem;
    }

    .post-description {
      font-size: 0.95rem;
    }
  }

  @media screen and (max-width: 480px) {
    .featured-title {
      font-size: 1.25rem;
    }

    p, li {
      font-size: 0.9rem;
    }
  }
</style>
