---
import DefaultLayout from '../../layouts/default.astro'
import Content from '../../layouts/body-content.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blogs')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content: PostContent } = await render(post)

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
---
<DefaultLayout>
  <Content>
    <p class="back"><a href="/blogs">← Blog</a></p>
    <p class="meta">{formatDate(post.data.pubDate)}</p>
    <h1>{post.data.title}</h1>
    <div class="post-body">
      <PostContent />
    </div>
  </Content>
</DefaultLayout>

<style>
  a {
    color: #0a9ef0;
  }

  .back {
    margin: 0.75rem 0 0.5rem;
    font-size: 1rem;
  }

  .back a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .meta {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    color: #555;
    font-family: Roboto, sans-serif;
    font-weight: 300;
  }

  h1,
  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: Roboto, sans-serif;
  }

  h1 {
    margin-bottom: 1rem;
  }

  .post-body :global(p),
  .post-body :global(li) {
    font-size: 1.2rem;
    font-weight: 300;
    font-family: Roboto, sans-serif;
    line-height: 1.55;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .post-body :global(a) {
    color: #0a9ef0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  .post-body :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background: #f5f5f5;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 1rem;
    font-family: Roboto, sans-serif;
  }

  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid #ddd;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .post-body :global(th) {
    background: #f5f5f5;
  }

  .post-body {
    padding-bottom: 2rem;
  }

  .diagram {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: #f8f9fa;
    border-left: 3px solid #0a9ef0;
    border-radius: 0 4px 4px 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #333;
    overflow-x: auto;
  }

  .diagram-line {
    white-space: pre;
  }

  .diagram-note {
    font-size: 0.8rem;
    color: #555;
    white-space: pre;
  }

  @media screen and (max-width: 767px) {
    .diagram {
      font-size: 0.78rem;
      padding: 0.75rem 1rem;
    }
  }

  @media screen and (max-width: 767px) {
    .post-body :global(p),
    .post-body :global(li) {
      font-size: 1rem;
    }

    .meta {
      font-size: 0.85rem;
    }
  }

  @media screen and (max-width: 480px) {
    .post-body :global(p),
    .post-body :global(li) {
      font-size: 0.9rem;
    }
  }
</style>
